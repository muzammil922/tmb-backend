generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum MovieStatus {
  ACTIVE
  DRAFT
}

enum MovieSource {
  TMDB
  MANUAL
}

enum SectionMode {
  AUTO
  MANUAL
}

enum ContentType {
  MOVIE
  SERIES
  ANIME
}

enum ContentSource {
  URDBOX
  MOVIESAPI
  IMDB3
  TMDB_ONLY
  HOSTED
}

enum PlaybackMode {
  URDBOX
  EMBED
  HOSTED
}

enum SyncStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum PlaybackStatus {
  PENDING
  WORKING
  BROKEN
}

model User {
  id           String     @id @default(cuid())
  name         String
  email        String     @unique
  password     String?
  avatar       String?
  role         UserRole   @default(USER)
  status       UserStatus @default(ACTIVE)
  googleId     String?    @unique
  refreshToken String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  watchlists   Watchlist[]
  favorites    Favorite[]
  watchHistory WatchHistory[]
}

model Movie {
  id            String      @id @default(cuid())
  tmdbId        Int?        @unique
  title         String
  originalTitle String?
  overview      String?
  posterPath    String?
  backdropPath  String?
  releaseDate   DateTime?
  runtime       Int?
  rating        Float?
  voteCount     Int?
  language      String?
  status        MovieStatus @default(DRAFT)
  source        MovieSource @default(TMDB)
  featured      Boolean     @default(false)
  videoUrl      String?
  videoProvider String?
  videoDuration Int?
  trailerKey    String?
  contentSource      ContentSource?
  playbackMode       PlaybackMode?
  playbackStatus     PlaybackStatus @default(PENDING)
  playbackCheckedAt  DateTime?
  syncPreset         String?
  upstreamId         String?
  upstreamSyncedAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  genres              MovieGenre[]
  cast                MovieCast[]
  watchlists          Watchlist[]
  favorites           Favorite[]
  watchHistory        WatchHistory[]
  homepageSectionMovies HomepageSectionMovie[]
  categoryMovies      CategoryMovie[]
}

model Genre {
  id     String @id @default(cuid())
  tmdbId Int?   @unique
  name   String @unique

  movies MovieGenre[]
  series SeriesGenre[]
}

model MovieGenre {
  movieId String
  genreId String
  movie   Movie  @relation(fields: [movieId], references: [id], onDelete: Cascade)
  genre   Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([movieId, genreId])
}

model MovieCast {
  id           String  @id @default(cuid())
  movieId      String
  tmdbPersonId Int?
  name         String
  character    String?
  profilePath  String?
  order        Int     @default(0)
  movie        Movie   @relation(fields: [movieId], references: [id], onDelete: Cascade)
}

model Watchlist {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model WatchHistory {
  id        String   @id @default(cuid())
  userId    String
  movieId   String
  progress  Float    @default(0)
  watchedAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  movie     Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([userId, movieId])
}

model HomepageSection {
  id       String      @id @default(cuid())
  title    String
  type     String
  order    Int         @default(0)
  isActive Boolean     @default(true)
  mode     SectionMode @default(AUTO)
  config   Json?

  movies HomepageSectionMovie[]
}

model HomepageSectionMovie {
  id        String @id @default(cuid())
  sectionId String
  movieId   String
  order     Int    @default(0)
  section   HomepageSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  movie     Movie           @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([sectionId, movieId])
}

model Banner {
  id         String    @id @default(cuid())
  title      String
  subtitle   String?
  imageUrl   String
  buttonText String?
  buttonUrl  String?
  startDate  DateTime?
  endDate    DateTime?
  isActive   Boolean   @default(true)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Category {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movies CategoryMovie[]
  series CategorySeries[]
}

model CategoryMovie {
  id         String @id @default(cuid())
  categoryId String
  movieId    String
  order      Int    @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  movie      Movie    @relation(fields: [movieId], references: [id], onDelete: Cascade)

  @@unique([categoryId, movieId])
}

model CategorySeries {
  id         String @id @default(cuid())
  categoryId String
  seriesId   String
  order      Int    @default(0)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  series     Series   @relation(fields: [seriesId], references: [id], onDelete: Cascade)

  @@unique([categoryId, seriesId])
}

model SyncSettings {
  id                String   @id @default("default")
  moviesApiEnabled  Boolean  @default(false)
  imdb3Enabled      Boolean  @default(true)
  automationEnabled Boolean  @default(false)
  syncIntervalHours Int      @default(24)
  lastScheduledSyncAt DateTime?
  lastImdb3Id       Int      @default(123290)
  imdb3DailyCount   Int      @default(20)
  scheduleStart     String?
  scheduleEnd       String?
  cronExpression    String?
  maxPagesPerRun    Int      @default(10)
  resultsPerPage    Int      @default(50)
  updatedAt         DateTime @updatedAt
}

model SyncJob {
  id           String        @id @default(cuid())
  source       ContentSource
  status       SyncStatus    @default(PENDING)
  startedAt    DateTime?
  completedAt  DateTime?
  imported     Int           @default(0)
  skipped      Int           @default(0)
  failed       Int           @default(0)
  errorMessage String?
  createdAt    DateTime      @default(now())
  logs         SyncLog[]
}

model SyncLog {
  id          String      @id @default(cuid())
  jobId       String
  job         SyncJob     @relation(fields: [jobId], references: [id], onDelete: Cascade)
  tmdbId      Int?
  upstreamId  String?
  title       String?
  action      String
  reason      String?
  contentType ContentType
  createdAt   DateTime    @default(now())
}

model Series {
  id               String         @id @default(cuid())
  tmdbId           Int?           @unique
  upstreamId       String?
  title            String
  originalTitle    String?
  overview         String?
  posterPath       String?
  backdropPath     String?
  firstAirDate     DateTime?
  lastAirDate      DateTime?
  numberOfSeasons  Int?           @default(1)
  numberOfEpisodes Int?           @default(1)
  rating           Float?
  voteCount        Int?
  language         String?
  status           MovieStatus    @default(ACTIVE)
  contentType      ContentType    @default(SERIES)
  contentSource      ContentSource?
  playbackMode       PlaybackMode?
  playbackStatus     PlaybackStatus @default(PENDING)
  playbackCheckedAt  DateTime?
  syncPreset         String?
  upstreamSyncedAt   DateTime?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  seasons          Season[]
  episodes         Episode[]
  categorySeries   CategorySeries[]
  genres           SeriesGenre[]
  cast             SeriesCast[]
}

model Season {
  id           String    @id @default(cuid())
  seriesId     String
  seasonNumber Int
  name         String?
  overview     String?
  posterPath   String?
  episodeCount Int       @default(0)
  series       Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  episodes     Episode[]

  @@unique([seriesId, seasonNumber])
}

model Episode {
  id            String    @id @default(cuid())
  seriesId      String
  seasonId      String
  seasonNumber  Int
  episodeNumber Int
  title         String
  overview      String?
  stillPath     String?
  airDate       DateTime?
  runtime       Int?
  voteAverage   Float?
  videoUrl      String?
  videoProvider String?
  upstreamId    String?
  series        Series    @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)

  @@unique([seasonId, episodeNumber])
}

model SeriesGenre {
  seriesId String
  genreId  String
  series   Series @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  genre    Genre  @relation(fields: [genreId], references: [id], onDelete: Cascade)

  @@id([seriesId, genreId])
}

model SeriesCast {
  id           String  @id @default(cuid())
  seriesId     String
  tmdbPersonId Int?
  name         String
  character    String?
  profilePath  String?
  order        Int     @default(0)
  series       Series  @relation(fields: [seriesId], references: [id], onDelete: Cascade)
}
